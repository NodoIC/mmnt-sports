# Copia este archivo como .env.local para desarrollo local (no lo subas con
# valores reales). En Netlify, estas mismas variables se configuran en
# Site settings → Environment variables. Ver README.md para más detalle.

# Clave de API de Resend (nunca debe exponerse al navegador).
RESEND_API_KEY=re_ejemplo_1234567890

# Remitente automático. Resend exige que el remitente use un dominio
# verificado en su panel — mmntsports@outlook.es (el email real confirmado)
# NO sirve aquí porque no es un dominio que puedas verificar en Resend.
# Deja este ejemplo con un dominio propio hasta que exista uno verificado.
CONTACT_FROM_EMAIL=MMNT Sports <no-reply@mmntsports.com>

# Dirección real a la que deben dirigirse las respuestas de quienes reciban
# el email de confirmación — esta sí es la dirección confirmada.
CONTACT_REPLY_TO_EMAIL=mmntsports@outlook.es

# URL pública del sitio (usada solo como enlace de pie en el email de confirmación).
SITE_URL=https://mmntsports.com
