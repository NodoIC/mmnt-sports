# Copia este archivo como .env.local para desarrollo local (no lo subas con
# valores reales). En Netlify, estas mismas variables se configuran en
# Site settings → Environment variables. Ver README.md para más detalle.

# Clave de API de Resend (nunca debe exponerse al navegador).
RESEND_API_KEY=re_ejemplo_1234567890

# Remitente automático. El dominio debe estar verificado en Resend.
CONTACT_FROM_EMAIL=Goals For Players <no-reply@goalsforplayers.com>

# Dirección a la que deben dirigirse las respuestas de quienes reciban el email.
CONTACT_REPLY_TO_EMAIL=contacto@goalsforplayers.com

# URL pública del sitio (usada solo como enlace de pie en el email de confirmación).
SITE_URL=https://goalsforplayers.com
